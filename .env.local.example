# Copie este arquivo pra .env.local e preencha com os valores do seu projeto Supabase.
# .env.local NÃO vai pro git (já está no .gitignore).

# Encontre em: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

